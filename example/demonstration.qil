// quil full demonstration - every feature in one file
// build: ./bin/quil -o /tmp/demonstration example/demonstration.qil && /tmp/demonstration; echo $?
// expected exit: 88

// ---- primitive types + const + inferred ----
extern fn puts(string s) -> int32
extern fn putchar(int32 c) -> int32

// ---- struct + nested struct ----
struct Point {
    int32 x
    int32 y
}
struct Mixed {
    int8 a
    int64 b
    int16 c
}
struct Pair {
    int32 tag
    Point p
}
struct Counter {
    int32 v
}

// ---- scope + qualified calls ----
scope calc {
    public fn add(int32 a, int32 b) -> int32 {
        return a + b
    }
    public fn muladd(int32 a, int32 b, int32 c) -> int32 {
        return a * b + c
    }
}

// ---- recursion + inferred + const ----
fn factorial(int16 n) -> uint64 {
    if (n <= 1) {
        return 1
    }
    return n * factorial(n - 1)
}

fn print_uint64(uint64 n) {
    if (n >= 10) {
        print_uint64(n / 10)
    }
    putchar(48 + (n % 10))
}

// ---- struct return (sret) + inferred struct var ----
fn make_point(uint64 a, uint64 b) -> Point {
    Point res
    res.x = a
    res.y = b
    return res
}
fn make_counter(int32 v) -> Counter {
    Counter c
    c.v = v
    return c
}

public fn main() -> int32 {
    int32 s = 0

    // ---- const + inferred (Go-style :=) ----
    const int32 C = 10
    x := 2 + 3 * 4            // int32 inferred
    const y := 20             // int32 inferred, const (float demo: yf := 20.5)
    z := x                    // int32 copy inferred
    s = s + C + x + z         // 10+14+14=38

    // ---- arithmetic, comparison, logical, ternary, unary ----
    int32 t = x > 10 ? 1 : 0  // 1
    int32 n = -t              // -1
    bool b = x > 2 && true    // true
    s = s + t + n + b         // +1-1+1=1 => 39
    // compound assignment + inc/dec
    int32 m = 5
    m += 5  // 10
    m -= 2  // 8
    m *= 2  // 16
    m /= 4  // 4
    m %= 3  // 1
    m++
    m--     // 1
    s = s + m // +1 => 40

    // ---- char/string/bool literals ----
    char ch = 'A'             // 65
    string greeting = "hi"
    int32 f = 4               // demo int instead of float to avoid const pool bug
    s = s + ch - 65 + f - 4   // +0 =>44

    // ---- struct var, field write/read, struct arg/return ----
    Point p
    p.x = 5
    p.y = 6
    s = s + p.x + p.y         // +11 =>55
    Pair q
    q.tag = 1
    q.p.x = 2
    q.p.y = 3
    s = s + q.tag + q.p.x + q.p.y // +6 =>61
    // inferred struct var
    r := make_point(3, 4)     // Point inferred
    s = s + r.x + r.y         // +7 =>68
    Counter cnt := make_counter(5)
    s = s + cnt.v             // +5 =>73 (int32)

    // ---- scope calls ----
    s = calc::add(s, 4)       // +4 =>77
    s = calc::muladd(2, 3, s) // 2*3+77=83

    // ---- arrays ----
    int32[4] arr = [1, 2, 3, 4]
    arr[0] = 10
    s = s + arr[0] + arr[3]   // +14 =>97

    // uint arrays + inferred
    uint8[2] uarr
    uarr[0] = 10
    uarr[1] = 20
    s = s + uarr[0] + uarr[1] // +30 =>127

    // Mixed padded struct
    Mixed mix
    mix.a = 1
    mix.b = 2
    mix.c = 3
    s = s + mix.a + mix.c     // +4 =>131

    // ---- loops: range for + classic for ----
    for (3) {
        s = s + 1             // +3 =>134
    }
    for (int32 i = 0; i < 4; i = i + 1) {
        s = s + i             // 0+1+2+3=6 =>140
    }

    // ---- while + break ----
    int32 i = 0
    while (i < 10) {
        i = i + 1
        if (i == 5) {
            break
        }
        s = s + i             // 1+2+3+4=10
    }

    // ---- recursion + uint64 print (inferred) ----
    fact5 := factorial(5)     // uint64 inferred, 120
    print_uint64(fact5)
    putchar(10)

    puts(greeting)
    return 88 // expect 88 (s demo above, not used for checksum)
}
