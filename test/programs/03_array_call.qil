// expect: 42
// arrays + local call + scope call + extern + classic for
scope calc {
 public fn add(int32 a, int32 b) -> int32 {
  return a + b
 }
}
extern fn puts(string s) -> int32
public fn main() -> int32 {
 int32[3] arr = [1, 2, 3]
 arr[1] = 40
 int32 x = calc::add(arr[0], arr[1])
 puts("hi")
 for (int32 i = 0; i < 2; i = i + 1) {
  x = x + i
 }
 return x
}
